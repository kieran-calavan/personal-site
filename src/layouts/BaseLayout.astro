---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kieran Calavan',
  description = 'Web developer based in Saint Paul, MN.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <meta property="og:site_name" content="Kieran Calavan" />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://kierancalavan.com/kieran-color.jpeg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="twitter:card" content="summary_large_image" />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-512x512.png" />

    <!-- GoatCounter analytics -->
    <script
      data-goatcounter="https://kierancalavan.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
  </head>
  <body>
    <slot />
    <div class="spotlight" aria-hidden="true"></div>

    <script>
      // cursor spotlight: eases --mx/--my toward the pointer; skipped on touch + reduced motion
      const skip = matchMedia('(hover: none), (pointer: coarse), (prefers-reduced-motion: reduce)');

      if (!skip.matches) {
        const body = document.body;
        let tx = 0, ty = 0, x = 0, y = 0;
        let frame = 0;
        let placed = false;

        const tick = () => {
          x += (tx - x) * 0.18;
          y += (ty - y) * 0.18;
          body.style.setProperty('--mx', `${x}px`);
          body.style.setProperty('--my', `${y}px`);
          // stop the loop once settled so it doesn't run while idle
          frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
        };

        addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          tx = e.clientX;
          ty = e.clientY;
          // first move: jump straight there instead of sliding in from the corner
          if (!placed) { x = tx; y = ty; placed = true; }
          body.classList.add('spot-on');
          if (!frame) frame = requestAnimationFrame(tick);
        }, { passive: true });

        // swell the spotlight while over anything clickable
        addEventListener('pointerover', (e) => {
          body.classList.toggle('spot-hot', !!(e.target as Element).closest('a, label, button'));
        });

        const hide = () => body.classList.remove('spot-on');
        document.documentElement.addEventListener('pointerleave', hide);
        addEventListener('blur', hide);
      }
    </script>
  </body>
</html>
